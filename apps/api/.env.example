# Port the API listens on. Cloud Run sets this itself.
PORT=3001
# The only origin allowed by CORS: the dashboard URL.
ALLOWED_ORIGIN=http://localhost:5174
# Firebase / GCP project ID; used to verify ID tokens.
GOOGLE_CLOUD_PROJECT=
# Cloud Storage bucket name, copied from Firebase console > Storage (no gs:// prefix).
STORAGE_BUCKET=
# Gemini API key from AI Studio. In production this comes from Secret Manager.
GEMINI_API_KEY=
