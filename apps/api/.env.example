# Port the API listens on. Cloud Run sets this itself.
PORT=3001
# The only origin allowed by CORS: the dashboard URL.
ALLOWED_ORIGIN=http://localhost:5174
# Firebase / GCP project ID; used to verify ID tokens.
GOOGLE_CLOUD_PROJECT=safely-ink
# Cloud Storage bucket name, copied from Firebase console > Storage (no gs:// prefix).
STORAGE_BUCKET=safely-ink.firebasestorage.app
# Gemini API key, the only secret here. The team's shared key is pulled with ORAS
# (docs/runbook.md section 2). In production this comes from Secret Manager.
GEMINI_API_KEY=
# Set all three to run each stage as a Cloud Task on the worker service
# (docs/runbook.md, "Task queue and worker"). Left unset, the stages run in the
# confirm request, which is what local development uses.
# TASKS_QUEUE=projects/safely-ink/locations/asia-southeast2/queues/stages
# WORKER_URL=
# TASKS_SERVICE_ACCOUNT=tasks@safely-ink.iam.gserviceaccount.com
