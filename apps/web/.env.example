# Public URL of this landing page; used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL of the dashboard; the "Check a document" button links here.
NEXT_PUBLIC_APP_URL=http://localhost:5174
# Optional. Google Analytics 4 measurement ID; loads only after the visitor accepts.
NEXT_PUBLIC_GA_ID=
# Optional. Search Console HTML-tag token, if the domain is not verified by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=
